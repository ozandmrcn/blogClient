# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# Every variable prefixed with VITE_ is inlined into the JavaScript bundle at
# build time, so none of them may hold a secret. Copy this file to `.env.local`
# for local work; `.env` and `.env.local` are both git-ignored.
#
# Origin the API is reached through. The service modules add the `/api` prefix
# themselves, so the prefix must not be repeated here.
#   local:   http://localhost:3000
#   hosted:  /api  — Vercel proxies /api/* to the API (see vercel.json), which
#           keeps requests on a single origin. A hosted client must not point at
#           the API's own domain: cross-site requests are treated as third-party
#           by the browser, and the httpOnly auth cookies are dropped.
VITE_API_URL=http://localhost:3000
