# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# Every variable prefixed with VITE_ is inlined into the JavaScript bundle at
# build time, so none of them may hold a secret. Copy this file to `.env.local`
# for local work; `.env` and `.env.local` are both git-ignored.
#
# Base URL of the API, WITHOUT the trailing /api segment — the services add it
# themselves so the prefix lives in exactly one place per request path.
#   local:   http://localhost:3000
#   hosted:  https://blog-api.onrender.com
VITE_API_URL=http://localhost:3000
